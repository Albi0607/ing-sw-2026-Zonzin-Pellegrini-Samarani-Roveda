<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.Button?>

<VBox fx:id="playerBoardRoot" prefWidth="600" prefHeight="160" maxWidth="600" maxHeight="160" styleClass="mesos-player-board" stylesheets="@../css/mesos-theme.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.mesos.view.GUI.Controllers.PlayerBoard.PlayerBoardController">
   <padding>
      <Insets top="10.0" />
   </padding>
   <children>
      <HBox fx:id="headerBox" alignment="CENTER" prefHeight="50.0" maxHeight="18.0"
            prefWidth="600.0" spacing="20.0">
         <children>

            <!-- Spazio flessibile a sinistra per centrare -->
            <HBox HBox.hgrow="ALWAYS" />

            <Label fx:id="playerNameLabel" text="Player" textAlignment="CENTER"
                   prefHeight="30.0" HBox.hgrow="NEVER">
               <font><Font size="20.0" /></font>
            </Label>

            <HBox fx:id="pointsBox" prefHeight="30.0" maxHeight="18.0"
                  spacing="20.0" alignment="CENTER" HBox.hgrow="NEVER">
               <HBox spacing="4" alignment="CENTER">
                  <Label fx:id="foodPointsLabel">
                     <font><Font size="20.0"/></font>
                  </Label>
                  <ImageView fitWidth="30" fitHeight="30" preserveRatio="true">
                     <image><Image url="/images/food_PP/1_food.png"/></image>
                  </ImageView>
               </HBox>
               <HBox spacing="4" alignment="CENTER">
                  <Label fx:id="prestigePointsLabel">
                     <font><Font size="20.0"/></font>
                  </Label>
                  <ImageView fitWidth="40" fitHeight="40" preserveRatio="true">
                     <image><Image url="/images/food_PP/1_PP.png"/></image>
                  </ImageView>
               </HBox>
            </HBox>

            <!-- Spazio flessibile a destra — stesso peso di quello a sinistra -->
            <HBox HBox.hgrow="ALWAYS" />

            <!-- SKIP rimane all'estrema destra fuori dal centro -->
            <Button fx:id="skipButton" text="SKIP" visible="false" managed="false"
                    disable="true"
                    styleClass="mesos-skip-button"
                    onMouseEntered="#onSkipHover"
                    onMouseExited="#onSkipHoverExit"
                    onAction="#onSkipClicked">
               <HBox.margin><Insets right="10.0"/></HBox.margin>
            </Button>

         </children>
      </HBox>
      <HBox fx:id="cardsContainer" alignment="CENTER" prefHeight="140.0" maxHeight="140" prefWidth="600.0" spacing="5.0" VBox.vgrow="NEVER">
         <children>
            <StackPane fx:id="cardSlot1" prefHeight="140.0" prefWidth="80.0" maxWidth="80" maxHeight="140.0">
               <HBox.margin>
                  <Insets bottom="5.0"/>
               </HBox.margin>
               <children>
                  <ImageView fx:id="cardImage1" fitHeight="140.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" />
                  <Label fx:id="cardCount1" alignment="TOP_LEFT" contentDisplay="TOP" text="0" textAlignment="CENTER" StackPane.alignment="TOP_LEFT" />
               </children>
            </StackPane>
            <StackPane fx:id="cardSlot2" prefHeight="140.0" prefWidth="80.0" maxWidth="80" maxHeight="140.0">
               <HBox.margin>
                  <Insets bottom="5.0"/>
               </HBox.margin>
               <children>
                  <ImageView fx:id="cardImage2" fitHeight="140.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" />
                  <Label fx:id="cardCount2" alignment="TOP_LEFT" contentDisplay="TOP" text="0" textAlignment="CENTER" StackPane.alignment="TOP_LEFT" />
               </children>
            </StackPane>
            <StackPane fx:id="cardSlot3" prefHeight="140.0" prefWidth="80.0" maxWidth="80" maxHeight="140.0">
               <HBox.margin>
                  <Insets bottom="5.0"/>
               </HBox.margin>
               <children>
                  <ImageView fx:id="cardImage3" fitHeight="140.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" />
                  <Label fx:id="cardCount3" alignment="TOP_LEFT" contentDisplay="TOP" text="0" textAlignment="CENTER" StackPane.alignment="TOP_LEFT" />
               </children>
            </StackPane>
            <StackPane fx:id="cardSlot4" prefHeight="140.0" prefWidth="80.0" maxWidth="80" maxHeight="140.0">
               <HBox.margin>
                  <Insets bottom="5.0"/>
               </HBox.margin>
               <children>
                  <ImageView fx:id="cardImage4" fitHeight="140.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" />
                  <Label fx:id="cardCount4" alignment="TOP_LEFT" contentDisplay="TOP" text="0" textAlignment="CENTER" StackPane.alignment="TOP_LEFT" />
               </children>
            </StackPane>
            <StackPane fx:id="cardSlot5" prefHeight="140.0" prefWidth="80.0" maxWidth="80" maxHeight="140.0">
               <HBox.margin>
                  <Insets bottom="5.0"/>
               </HBox.margin>
               <children>
                  <ImageView fx:id="cardImage5" fitHeight="140.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" />
                  <Label fx:id="cardCount5" alignment="TOP_LEFT" contentDisplay="TOP" text="0" textAlignment="CENTER" StackPane.alignment="TOP_LEFT" />
               </children>
            </StackPane>
            <StackPane fx:id="cardSlot6" prefHeight="140.0" prefWidth="80.0" maxWidth="80" maxHeight="140.0">
               <HBox.margin>
                  <Insets bottom="5.0"/>
               </HBox.margin>
               <children>
                  <ImageView fx:id="cardImage6" fitHeight="140.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" />
                  <Label fx:id="cardCount6" alignment="TOP_LEFT" contentDisplay="TOP" text="0" textAlignment="CENTER" StackPane.alignment="TOP_LEFT" />
               </children>
            </StackPane>
            <StackPane fx:id="cardSlot7" prefHeight="140.0" prefWidth="80.0" maxWidth="80" maxHeight="140.0">
               <HBox.margin>
                  <Insets bottom="5.0"/>
               </HBox.margin>
               <children>
                  <ImageView fx:id="cardImage7" fitHeight="140.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" />
                  <Label fx:id="cardCount7" alignment="TOP_LEFT" contentDisplay="TOP" text="0" textAlignment="CENTER" StackPane.alignment="TOP_LEFT" />
               </children>
            </StackPane>
         </children>
      </HBox>
   </children>
</VBox>
